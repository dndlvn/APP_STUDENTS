<Window x:Class="APP_STUDENTS.windows.EditGradesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:APP_STUDENTS.windows"
        mc:Ignorable="d"
        Icon="/image/лого.png"
        Title="Оценки ученика" Height="320" Width="420" WindowStartupLocation="CenterOwner">
    <Grid Margin="8" Background="BurlyWood">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TbTitle" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

        <DataGrid Background="BurlyWood" x:Name="GridGrades" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" >
            <DataGrid.Columns>
                <DataGridTextColumn Header="Предмет" Binding="{Binding SubjectName}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="Четверть" Binding="{Binding TermName}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="Оценка" Binding="{Binding GradeValue}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Сохранить" Width="100" Margin="4" Click="Save_Click"/>
            <Button Content="Отмена" Width="100" Margin="4" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
